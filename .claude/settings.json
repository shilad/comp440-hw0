{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "Bash(uv sync)",
      "Bash(uv run python load_data.py)",
      "Bash(uv run python run_all.py)",
      "Bash(uv run python human_part1.py)",
      "Bash(uv run python human_part2.py)",
      "Bash(uv run python human_part3.py)",
      "Bash(uv run python claude_answers_1_2_3.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git fetch upstream --quiet 2>/dev/null; git log --oneline HEAD..upstream/main 2>/dev/null",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python dump_transcript.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
